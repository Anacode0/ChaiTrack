<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.ChaiTrack" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Background color -->
        <item name="android:windowBackground">@color/white</item>

        <!-- Outline color -->
        <item name="colorOutline">@color/outline</item>

        <!-- CardView style -->
        <item name="cardViewStyle">@style/CardView.ChaiTrack</item>

        <!-- Button styles -->
        <item name="materialButtonStyle">@style/Button.ChaiTrack</item>
        <item name="borderlessButtonStyle">@style/BorderlessButton.ChaiTrack</item>

        <!-- Text styles -->
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/gray_dark</item>

        <!-- Bottom Navigation -->
        <item name="bottomNavigationStyle">@style/BottomNavigation.ChaiTrack</item>
    </style>

    <!-- CardView Style -->
    <style name="CardView.ChaiTrack" parent="CardView">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <!-- Borderless Button Style -->
    <style name="BorderlessButton.ChaiTrack" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Bottom Navigation Style -->
    <style name="BottomNavigation.ChaiTrack" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/teal_700</item>
        <item name="itemTextColor">@color/black</item>
        <item name="itemBackground">@color/white</item>
        <item name="android:elevation">@dimen/bottom_nav_elevation</item>
        <item name="android:background">@color/white</item>
    </style>

    <!-- REMOVED EditText.ChaiTrack from here - it's in styles.xml -->

    <!-- Splash Screen Theme -->
    <style name="Theme.ChaiTrack.Splash" parent="Theme.ChaiTrack">
        <item name="android:windowBackground">@drawable/splash_screen_background</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
    </style>

    <!-- Dialog Theme -->
    <style name="Theme.ChaiTrack.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorAccent">@color/teal_200</item>
    </style>

    <!-- Chat Message Theme -->
    <style name="ChatMessageSent">
        <item name="android:background">@color/message_sent_background</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="ChatMessageReceived">
        <item name="android:background">@color/message_received_background</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- Progress Bar Style -->
    <style name="ProgressBar.ChaiTrack" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackColor">@color/gray_light</item>
        <item name="indicatorColor">@color/colorPrimary</item>
        <item name="trackThickness">@dimen/progress_height</item>
        <item name="trackCornerRadius">@dimen/progress_corner_radius</item>
    </style>

    <!-- Chip Style -->
    <style name="Chip.ChaiTrack" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/gray_light</item>
        <item name="chipStrokeColor">@color/gray_dark</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">@dimen/chip_corner_radius</item>
    </style>

</resources>